<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>Select Server | LFamiliaHelper</title>

    <link rel="icon" type="image/ico" href="/dist/img/atlanta.ico" />
    <link rel="stylesheet" href="/css/modern.css" />

    <style>
      .server-page {
        min-height: 100vh;
        padding: 40px 24px;
        background:
          radial-gradient(
            circle at top right,
            rgba(88, 101, 242, 0.12),
            transparent 35%
          ),
          var(--bg);
      }

      .server-container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
      }

      .server-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 35px;
      }

      .server-heading h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 850;
        letter-spacing: -0.03em;
      }

      .server-heading p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 14px;
      }

      .user-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px 8px 8px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.035);
      }

      .user-pill img {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        object-fit: cover;
      }

      .user-pill strong {
        display: block;
        font-size: 13px;
      }

      .user-pill span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: 11px;
      }

      .server-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .server-card {
        position: relative;
        overflow: hidden;
        min-height: 250px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 20px;
        background:
          linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.055),
            rgba(255, 255, 255, 0.018)
          );
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
        transition:
          transform 0.2s ease,
          border-color 0.2s ease,
          box-shadow 0.2s ease;
      }

      .server-card::before {
        content: "";
        position: absolute;
        width: 180px;
        height: 180px;
        right: -80px;
        top: -90px;
        border-radius: 50%;
        background: rgba(88, 101, 242, 0.14);
        filter: blur(10px);
      }

      .server-card:hover {
        transform: translateY(-5px);
        border-color: rgba(88, 101, 242, 0.45);
        box-shadow: 0 25px 65px rgba(0, 0, 0, 0.28);
      }

      .server-info {
        position: relative;
        z-index: 1;
      }

      .server-icon {
        width: 76px;
        height: 76px;
        margin-bottom: 18px;
        border-radius: 22px;
        object-fit: cover;
        background: var(--panel-2);
        border: 1px solid var(--border);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
      }

      .server-icon-fallback {
        width: 76px;
        height: 76px;
        margin-bottom: 18px;
        display: grid;
        place-items: center;
        border-radius: 22px;
        background: var(--accent);
        color: white;
        font-size: 30px;
        font-weight: 800;
      }

      .server-name {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .server-id {
        margin-top: 5px;
        color: var(--muted);
        font-size: 11px;
      }

      .server-bottom {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 24px;
      }

      .server-members {
        color: var(--muted);
        font-size: 12px;
      }

      .manage-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 100px;
        padding: 10px 15px;
        border-radius: 11px;
        background: var(--accent);
        color: white;
        font-size: 12px;
        font-weight: 750;
        transition: 0.18s ease;
      }

      .manage-button:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
        color: white;
      }

      .empty-server {
        padding: 70px 20px;
        text-align: center;
        border: 1px dashed var(--border);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.02);
      }

      .empty-server-icon {
        font-size: 40px;
        margin-bottom: 15px;
      }

      .empty-server h2 {
        margin: 0;
        font-size: 20px;
      }

      .empty-server p {
        color: var(--muted);
        margin: 8px 0 0;
      }

      @media (max-width: 1000px) {
        .server-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 650px) {
        .server-page {
          padding: 25px 14px;
        }

        .server-top {
          align-items: flex-start;
        }

        .server-heading h1 {
          font-size: 26px;
        }

        .user-pill {
          display: none;
        }

        .server-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <main class="server-page">
      <div class="server-container">

        <div class="server-top">
          <div class="server-heading">
            <h1>Select a Server</h1>
            <p>
              Choose a Discord server to manage with LFamiliaHelper.
            </p>
          </div>

          <% if (typeof user !== "undefined" && user) { %>
            <div class="user-pill">
              <% if (user.displayAvatar) { %>
                <img
                  src="<%= user.displayAvatar %>"
                  alt="Avatar"
                />
              <% } %>

              <div>
                <strong>
                  <%= user.username || "User" %>
                </strong>
                <span>Administrator</span>
              </div>
            </div>
          <% } %>
        </div>

        <% if (guilds && guilds.length > 0) { %>

          <div class="server-grid">

            <% guilds.forEach((guild) => { %>

              <article class="server-card">

                <div class="server-info">

                  <% if (guild.iconURL) { %>

                    <img
                      class="server-icon"
                      src="<%= guild.iconURL %>"
                      alt="<%= guild.name %>"
                      loading="lazy"
                    />

                  <% } else { %>

                    <div class="server-icon-fallback">
                      <%= guild.name
                        ? guild.name.charAt(0).toUpperCase()
                        : "?" %>
                    </div>

                  <% } %>

                  <h2 class="server-name" title="<%= guild.name %>">
                    <%= guild.name %>
                  </h2>

                  <% if (guild.id) { %>
                    <div class="server-id">
                      ID: <%= guild.id %>
                    </div>
                  <% } %>

                </div>

                <div class="server-bottom">

                  <span class="server-members">
                    <%= guild.memberCount || 0 %> members
                  </span>

                  <a
                    class="manage-button"
                    href="<%= guild.settingsUrl %>"
                  >
                    Manage →
                  </a>

                </div>

              </article>

            <% }); %>

          </div>

        <% } else %>

          <div class="empty-server">
            <div class="empty-server-icon">🛰️</div>

            <h2>No servers available</h2>

            <p>
              There are no Discord servers available for you to manage.
            </p>
          </div>

        <% } %>

      </div>
    </main>
  </body>
</html>
