<!DOCTYPE html>
<html lang="en">
  <%- include('includes/head') %>

  <style>
    :root {
      --modern-bg: #080a0f;
      --modern-card: rgba(20, 24, 34, 0.78);
      --modern-card-hover: rgba(27, 32, 45, 0.95);
      --modern-border: rgba(255, 255, 255, 0.08);
      --modern-text: #f5f7ff;
      --modern-muted: #9299aa;
      --modern-accent: #5865f2;
      --modern-accent-hover: #4752c4;
    }

    html,
    body {
      min-height: 100%;
      margin: 0;
      background:
        radial-gradient(
          circle at 10% 0%,
          rgba(88, 101, 242, 0.16),
          transparent 32%
        ),
        radial-gradient(
          circle at 90% 20%,
          rgba(114, 137, 218, 0.08),
          transparent 30%
        ),
        var(--modern-bg) !important;
      color: var(--modern-text) !important;
      font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif !important;
    }

    body {
      overflow-x: hidden;
    }

    /* Hide old AdminLTE layout */
    .main-header,
    .main-sidebar,
    .control-sidebar,
    .main-footer {
      display: none !important;
    }

    .content-wrapper {
      min-height: 100vh !important;
      margin-left: 0 !important;
      background: transparent !important;
    }

    .modern-page {
      width: 100%;
      min-height: 100vh;
      padding: 45px 25px 60px;
    }

    .modern-container {
      width: 100%;
      max-width: 1250px;
      margin: auto;
    }

    /* Header */

    .modern-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 38px;
    }

    .modern-title h1 {
      margin: 0;
      color: var(--modern-text);
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .modern-title p {
      margin: 8px 0 0;
      color: var(--modern-muted);
      font-size: 14px;
    }

    .modern-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 13px;
      border: 1px solid var(--modern-border);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.035);
      color: var(--modern-muted);
      font-size: 12px;
      font-weight: 600;
    }

    .modern-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #3ba55d;
      box-shadow: 0 0 12px rgba(59, 165, 93, 0.8);
    }

    /* Grid */

    .modern-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }

    /* Card */

    .server-card {
      position: relative;
      min-width: 0;
      overflow: hidden;
      padding: 0;
      border: 1px solid var(--modern-border);
      border-radius: 22px;
      background: var(--modern-card);
      box-shadow: 0 18px 55px rgba(0, 0, 0, 0.22);
      backdrop-filter: blur(18px);
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
    }

    .server-card::before {
      content: "";
      position: absolute;
      top: -90px;
      right: -70px;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: rgba(88, 101, 242, 0.14);
      filter: blur(25px);
      pointer-events: none;
    }

    .server-card:hover {
      transform: translateY(-6px);
      border-color: rgba(88, 101, 242, 0.42);
      background: var(--modern-card-hover);
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.3);
    }

    .server-card-inner {
      position: relative;
      z-index: 1;
      padding: 23px;
    }

    /* Server icon */

    .server-icon-wrap {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
    }

    .server-icon {
      width: 78px;
      height: 78px;
      display: block;
      border-radius: 22px;
      object-fit: cover;
      background: #151924;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
    }

    .server-icon-fallback {
      width: 78px;
      height: 78px;
      display: grid;
      place-items: center;
      border-radius: 22px;
      background: linear-gradient(
        135deg,
        #5865f2,
        #7289da
      );
      color: white;
      font-size: 30px;
      font-weight: 800;
      box-shadow: 0 12px 30px rgba(88, 101, 242, 0.3);
    }

    .server-mark {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(88, 101, 242, 0.1);
      color: #8c96ff;
      font-size: 15px;
    }

    /* Text */

    .server-name {
      margin: 0;
      overflow: hidden;
      color: var(--modern-text);
      font-size: 19px;
      font-weight: 750;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .server-description {
      margin-top: 7px;
      color: var(--modern-muted);
      font-size: 12px;
    }

    /* Footer */

    .server-footer {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 17px 23px;
      border-top: 1px solid var(--modern-border);
      background: rgba(0, 0, 0, 0.12);
    }

    .server-status {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--modern-muted);
      font-size: 11px;
      font-weight: 600;
    }

    .server-status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #3ba55d;
      box-shadow: 0 0 10px rgba(59, 165, 93, 0.7);
    }

    .manage-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 105px;
      padding: 10px 15px;
      border: 0;
      border-radius: 11px;
      background: var(--modern-accent);
      color: white !important;
      font-size: 12px;
      font-weight: 700;
      text-decoration: none !important;
      transition: 0.18s ease;
    }

    .manage-btn:hover {
      background: var(--modern-accent-hover);
      color: white !important;
      transform: translateY(-1px);
    }

    .invite-btn {
      background: #3ba55d;
    }

    .invite-btn:hover {
      background: #2d8548;
    }

    /* Empty */

    .empty-card {
      padding: 70px 25px;
      border: 1px dashed var(--modern-border);
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.025);
      text-align: center;
    }

    .empty-icon {
      width: 70px;
      height: 70px;
      display: grid;
      place-items: center;
      margin: 0 auto 20px;
      border-radius: 20px;
      background: rgba(88, 101, 242, 0.12);
      color: #8c96ff;
      font-size: 28px;
    }

    .empty-card h2 {
      margin: 0;
      color: var(--modern-text);
      font-size: 20px;
      font-weight: 750;
    }

    .empty-card p {
      max-width: 430px;
      margin: 9px auto 0;
      color: var(--modern-muted);
      font-size: 13px;
    }

    /* Responsive */

    @media (max-width: 1050px) {
      .modern-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 650px) {
      .modern-page {
        padding: 25px 14px 40px;
      }

      .modern-header {
        margin-bottom: 25px;
      }

      .modern-title h1 {
        font-size: 27px;
      }

      .modern-title p {
        font-size: 13px;
      }

      .modern-badge {
        display: none;
      }

      .modern-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .server-card-inner {
        padding: 20px;
      }

      .server-footer {
        padding: 15px 20px;
      }
    }
  </style>

  <body>
    <div class="content-wrapper">
      <main class="modern-page">
        <div class="modern-container">

          <div class="modern-header">
            <div class="modern-title">
              <h1>Select a Server</h1>
              <p>
                Choose a Discord server to manage with LFamiliaHelper.
              </p>
            </div>

            <div class="modern-badge">
              <span class="modern-badge-dot"></span>
              Dashboard Online
            </div>
          </div>

          <% if (user.displayedGuilds) { %>

            <div class="modern-grid">

              <% user.displayedGuilds.forEach(function(guild) { %>

                <article class="server-card">

                  <div class="server-card-inner">

                    <div class="server-icon-wrap">

                      <% if (guild.iconURL) { %>

                        <img
                          src="<%= guild.iconURL %>"
                          alt="<%= guild.name %>"
                          class="server-icon"
                          loading="lazy"
                        />

                      <% } else { %>

                        <div class="server-icon-fallback">
                          <%= guild.name
                            ? guild.name.charAt(0).toUpperCase()
                            : "?" %>
                        </div>

                      <% } %>

                      <div class="server-mark">
                        <i class="fa fa-cog"></i>
                      </div>

                    </div>

                    <h2
                      class="server-name"
                      title="<%= guild.name %>"
                    >
                      <%= guild.name %>
                    </h2>

                    <div class="server-description">
                      Discord server
                    </div>

                  </div>

                  <div class="server-footer">

                    <div class="server-status">
                      <span class="server-status-dot"></span>
                      Available
                    </div>

                    <% if (guild.settingsUrl.includes('discordapp.com')) { %>

                      <a
                        href="<%= guild.settingsUrl %>"
                        class="manage-btn invite-btn"
                      >
                        Invite
                      </a>

                    <% } else { %>

                      <a
                        href="<%= guild.settingsUrl %>"
                        class="manage-btn"
                      >
                        Manage →
                      </a>

                    <% } %>

                  </div>

                </article>

              <% }); %>

            </div>

          <% } else { %>

            <div class="empty-card">

              <div class="empty-icon">
                <i class="fa fa-server"></i>
              </div>

              <h2>No server found</h2>

              <p>
                No server is available to display.
                Make sure you are logged in with the correct Discord account.
              </p>

            </div>

          <% } %>

        </div>
      </main>
    </div>
  </body>
</html>
