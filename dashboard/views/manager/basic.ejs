<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../includes/head') %>

  <style>
    :root {
      --lf-bg: #080a0f;
      --lf-bg-soft: #0d1017;
      --lf-card: #11151e;
      --lf-card-2: #171c26;
      --lf-border: rgba(255,255,255,.075);
      --lf-border-hover: rgba(88,101,242,.45);
      --lf-text: #f5f7fb;
      --lf-muted: #8992a5;
      --lf-muted-2: #687184;
      --lf-accent: #5865f2;
      --lf-accent-hover: #4752c4;
      --lf-success: #23c483;
      --lf-danger: #ed4245;
      --lf-radius: 18px;
      --lf-shadow: 0 18px 55px rgba(0,0,0,.25);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      min-height: 100%;
      background: var(--lf-bg) !important;
    }

    body {
      color: var(--lf-text);
    }

    .content-wrapper {
      min-height: calc(100vh - 50px) !important;
      background:
        radial-gradient(
          circle at 85% -5%,
          rgba(88,101,242,.16),
          transparent 32%
        ),
        radial-gradient(
          circle at 10% 40%,
          rgba(88,101,242,.045),
          transparent 28%
        ),
        var(--lf-bg) !important;
    }

    /* =========================================
       PAGE HEADER
    ========================================= */

    .content-header {
      padding: 28px 30px 12px !important;
    }

    .content-header h3 {
      margin: 0 !important;
      color: var(--lf-text) !important;
      font-size: 26px !important;
      font-weight: 850 !important;
      letter-spacing: -.035em;
    }

    .breadcrumb {
      margin-top: 9px !important;
      padding: 0 !important;
      background: transparent !important;
      color: var(--lf-muted) !important;
    }

    .breadcrumb a {
      color: var(--lf-muted) !important;
      text-decoration: none !important;
    }

    .breadcrumb a:hover {
      color: var(--lf-text) !important;
    }

    .breadcrumb .active {
      color: var(--lf-text) !important;
    }

    /* =========================================
       MAIN PAGE
    ========================================= */

    .lf-page {
      width: 100%;
      max-width: 1500px;
      margin: 0 auto;
      padding: 10px 30px 50px;
    }

    /* =========================================
       SERVER HERO
    ========================================= */

    .lf-hero {
      position: relative;
      overflow: hidden;
      min-height: 150px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
      padding: 28px;
      margin-bottom: 22px;
      border: 1px solid var(--lf-border);
      border-radius: 22px;
      background:
        linear-gradient(
          135deg,
          rgba(88,101,242,.16),
          rgba(255,255,255,.025) 55%,
          rgba(255,255,255,.015)
        ),
        var(--lf-card);
      box-shadow: var(--lf-shadow);
    }

    .lf-hero::before {
      content: "";
      position: absolute;
      width: 330px;
      height: 330px;
      right: -130px;
      top: -190px;
      border-radius: 50%;
      background: rgba(88,101,242,.16);
      filter: blur(25px);
      pointer-events: none;
    }

    .lf-hero::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      left: 38%;
      bottom: -160px;
      border-radius: 50%;
      background: rgba(88,101,242,.06);
      filter: blur(20px);
      pointer-events: none;
    }

    .lf-hero-content {
      position: relative;
      z-index: 2;
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .lf-server-icon,
    .lf-server-fallback {
      width: 72px;
      height: 72px;
      flex: 0 0 72px;
      border-radius: 20px;
    }

    .lf-server-icon {
      object-fit: cover;
      background: var(--lf-card-2);
      border: 1px solid rgba(255,255,255,.1);
      box-shadow: 0 15px 35px rgba(0,0,0,.3);
    }

    .lf-server-fallback {
      display: grid;
      place-items: center;
      background: linear-gradient(
        135deg,
        var(--lf-accent),
        #7983ff
      );
      color: white;
      font-size: 28px;
      font-weight: 850;
      box-shadow: 0 15px 35px rgba(88,101,242,.25);
    }

    .lf-server-meta {
      min-width: 0;
    }

    .lf-server-meta h1 {
      margin: 0;
      max-width: 650px;
      overflow: hidden;
      color: var(--lf-text);
      font-size: 25px;
      font-weight: 850;
      letter-spacing: -.035em;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .lf-server-meta p {
      margin: 6px 0 0;
      color: var(--lf-muted);
      font-size: 13px;
    }

    .lf-server-status {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-top: 11px;
      padding: 5px 9px;
      border: 1px solid rgba(35,196,131,.16);
      border-radius: 999px;
      background: rgba(35,196,131,.06);
      color: #6de1b1;
      font-size: 10px;
      font-weight: 750;
    }

    .lf-status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--lf-success);
      box-shadow: 0 0 10px rgba(35,196,131,.65);
    }

    .lf-back {
      position: relative;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 11px 15px;
      border: 1px solid var(--lf-border);
      border-radius: 11px;
      background: rgba(255,255,255,.035);
      color: var(--lf-text) !important;
      font-size: 12px;
      font-weight: 750;
      text-decoration: none !important;
      white-space: nowrap;
      transition: .18s ease;
    }

    .lf-back:hover {
      border-color: var(--lf-border-hover);
      background: rgba(88,101,242,.1);
      color: white !important;
      transform: translateY(-1px);
    }

    /* =========================================
       SETTINGS GRID
    ========================================= */

    .lf-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .lf-card {
      overflow: hidden;
      min-width: 0;
      border: 1px solid var(--lf-border);
      border-radius: var(--lf-radius);
      background: var(--lf-card);
      box-shadow: 0 12px 42px rgba(0,0,0,.18);
      transition:
        transform .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
    }

    .lf-card:hover {
      border-color: rgba(255,255,255,.12);
      box-shadow: 0 18px 55px rgba(0,0,0,.25);
      transform: translateY(-2px);
    }

    .lf-card.full {
      grid-column: 1 / -1;
    }

    /* =========================================
       CARD HEADER
    ========================================= */

    .lf-card-head {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 18px 20px;
      border-bottom: 1px solid var(--lf-border);
      background: rgba(255,255,255,.018);
    }

    .lf-card-icon {
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(88,101,242,.14);
      border-radius: 12px;
      background: rgba(88,101,242,.11);
      color: #8992ff;
      font-size: 17px;
    }

    .lf-card-title {
      min-width: 0;
    }

    .lf-card-title h2 {
      margin: 0;
      color: var(--lf-text);
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -.01em;
    }

    .lf-card-title p {
      margin: 3px 0 0;
      color: var(--lf-muted);
      font-size: 11px;
    }

    .lf-card-body {
      padding: 20px;
    }

    /* =========================================
       FORM
    ========================================= */

    .lf-field {
      margin-bottom: 18px;
    }

    .lf-field:last-child {
      margin-bottom: 0;
    }

    .lf-field > label:not(.lf-check) {
      display: block;
      margin-bottom: 8px;
      color: #dfe3ec;
      font-size: 11px;
      font-weight: 750;
    }

    .lf-input,
    .lf-select {
      width: 100%;
      min-height: 43px;
      padding: 10px 12px;
      border: 1px solid var(--lf-border) !important;
      border-radius: 11px !important;
      outline: none !important;
      background: var(--lf-card-2) !important;
      color: var(--lf-text) !important;
      box-shadow: none !important;
      font-size: 12px;
      transition:
        border-color .18s ease,
        box-shadow .18s ease,
        background .18s ease;
    }

    .lf-input:hover,
    .lf-select:hover {
      border-color: rgba(255,255,255,.13) !important;
    }

    .lf-input:focus,
    .lf-select:focus {
      border-color: rgba(88,101,242,.75) !important;
      background: #191e29 !important;
      box-shadow: 0 0 0 3px rgba(88,101,242,.11) !important;
    }

    .lf-input::placeholder {
      color: var(--lf-muted-2);
    }

    .lf-select option {
      background: #171b24;
      color: white;
    }

    .lf-select[multiple] {
      min-height: 150px;
      padding: 8px;
    }

    /* =========================================
       TOGGLE ROWS
    ========================================= */

    .lf-checks {
      display: grid;
      gap: 10px;
    }

    .lf-check {
      position: relative;
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      width: 100%;
      margin: 0 !important;
      padding: 13px 14px;
      border: 1px solid var(--lf-border);
      border-radius: 12px;
      background: rgba(255,255,255,.02);
      cursor: pointer;
      transition: .18s ease;
    }

    .lf-check:hover {
      border-color: rgba(88,101,242,.35);
      background: rgba(88,101,242,.055);
    }

    .lf-check-text {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .lf-check-title {
      color: #e9ecf3;
      font-size: 12px;
      font-weight: 750;
    }

    .lf-check-description {
      color: var(--lf-muted);
      font-size: 10px;
      font-weight: 400;
      line-height: 1.45;
    }

    .lf-check input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .lf-switch {
      position: relative;
      width: 42px;
      height: 23px;
      flex: 0 0 42px;
      border-radius: 999px;
      background: #292f3b;
      transition: .2s ease;
    }

    .lf-switch::after {
      content: "";
      position: absolute;
      left: 3px;
      top: 3px;
      width: 17px;
      height: 17px;
      border-radius: 50%;
      background: #858d9d;
      box-shadow: 0 2px 5px rgba(0,0,0,.25);
      transition: .2s ease;
    }

    .lf-check input:checked + .lf-switch {
      background: var(--lf-accent);
      box-shadow: 0 0 15px rgba(88,101,242,.22);
    }

    .lf-check input:checked + .lf-switch::after {
      left: 22px;
      background: white;
    }

    /* =========================================
       AUTOMOD
    ========================================= */

    .lf-automod-grid {
      display: grid;
      grid-template-columns: minmax(250px,.8fr) minmax(0,1.2fr);
      gap: 22px;
    }

    .lf-automod-panel {
      padding: 15px;
      border: 1px solid var(--lf-border);
      border-radius: 14px;
      background: rgba(255,255,255,.018);
    }

    .lf-panel-title {
      margin-bottom: 13px;
      color: #dfe3ec;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .lf-automod-toggles {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 9px;
    }

    .lf-automod-toggles .lf-check {
      min-height: 58px;
      padding: 11px;
    }

    /* =========================================
       FOOTER / SAVE
    ========================================= */

    .lf-card-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      padding: 14px 20px;
      border-top: 1px solid var(--lf-border);
      background: rgba(255,255,255,.012);
    }

    .lf-save {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      min-width: 112px;
      padding: 10px 17px !important;
      border: 0 !important;
      border-radius: 10px !important;
      background: var(--lf-accent) !important;
      color: white !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      box-shadow: 0 8px 20px rgba(88,101,242,.15) !important;
      transition: .18s ease;
    }

    .lf-save:hover {
      background: var(--lf-accent-hover) !important;
      box-shadow: 0 10px 25px rgba(88,101,242,.25) !important;
      transform: translateY(-1px);
    }

    .lf-help {
      margin-top: 7px;
      color: var(--lf-muted-2);
      font-size: 10px;
      line-height: 1.5;
    }

    /* Remove old AdminLTE visual boxes */

    .box,
    .box-header,
    .box-body,
    .box-footer {
      background: transparent !important;
      border: 0 !important;
      box-shadow: none !important;
    }

    /*
=========================================
       RESPONSIVE
    ========================================= */

    @media (max-width: 1100px) {
      .lf-grid {
        grid-template-columns: 1fr;
      }

      .lf-card.full {
        grid-column: auto;
      }

      .lf-automod-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .content-header {
        padding: 20px 15px 10px !important;
      }

      .content-header h3 {
        font-size: 22px !important;
      }

      .lf-page {
        padding: 8px 15px 35px;
      }

      .lf-hero {
        align-items: flex-start;
        flex-direction: column;
        padding: 19px;
      }

      .lf-hero-content {
        width: 100%;
      }

      .lf-server-icon,
      .lf-server-fallback {
        width: 60px;
        height: 60px;
        flex-basis: 60px;
        border-radius: 17px;
      }

      .lf-server-meta h1 {
        max-width: 230px;
        font-size: 19px;
      }

      .lf-server-meta p {
        font-size: 11px;
      }

      .lf-back {
        width: 100%;
      }

      .lf-card-body {
        padding: 16px;
      }

      .lf-card-footer {
        padding: 13px 16px;
      }

      .lf-automod-toggles {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 430px) {
      .lf-hero-content {
        align-items: flex-start;
      }

      .lf-server-meta h1 {
        max-width: 185px;
      }

      .lf-card-head {
        padding: 16px;
      }

      .lf-card-icon {
        width: 36px;
        height: 36px;
        flex-basis: 36px;
      }
    }
  </style>
</head>

<body class="hold-transition skin-blue sidebar-mini">

<div class="wrapper">

  <%- include('../includes/header') %>
  <%- include('../includes/sidebar') %>

  <div class="content-wrapper">

    <section class="content-header">
      <h3>Server Settings</h3>

      <ol class="breadcrumb">
        <li>
          <a href="/">
            <i class="fa fa-home"></i>
            Selector
          </a>
        </li>

        <li>
          <a href="<%=`/manage/${guild.id}/`%>">
            <%= guild.name %>
          </a>
        </li>

        <li class="active">
          Basic
        </li>
      </ol>
    </section>

    <section class="content">

      <div class="lf-page">

        <!--
=====================================
             SERVER HERO
        ====================================== -->

        <div class="lf-hero">

          <div class="lf-hero-content">

            <% if (guild.iconURL) { %>

              <img
                class="lf-server-icon"
                src="<%= guild.iconURL %>"
                alt="<%= guild.name %>"
              />

            <% } else { %>

              <div class="lf-server-fallback">
                <%= guild.name
                  ? guild.name.charAt(0).toUpperCase()
                  : "?" %>
              </div>

            <% } %>

            <div class="lf-server-meta">

              <h1 title="<%= guild.name %>">
                <%= guild.name %>
              </h1>

              <p>
                Manage and configure LFamiliaHelper for this server.
              </p>

              <div class="lf-server-status">
                <span class="lf-status-dot"></span>
                Bot Connected
              </div>

            </div>

          </div>

          <a
            class="lf-back"
            href="<%=`/manage/${guild.id}/`%>"
          >
            <i class="fa fa-arrow-left"></i>
            Back to Dashboard
          </a>

        </div>


        <!-- =====================================
             SETTINGS GRID
        ====================================== -->

        <div class="lf-grid">


          <!-- ===================================
               GENERAL
          ==================================== -->

          <div class="lf-card">

            <div class="lf-card-head">

              <div class="lf-card-icon">
                <i class="fa fa-sliders"></i>
              </div>

              <div class="lf-card-title">
                <h2>General</h2>
                <p>Core bot settings for this server</p>
              </div>

            </div>

            <form
              role="form"
              action="/manage/<%= guild.id %>/basic/"
              method="POST"
            >

              <div class="lf-card-body">

                <div class="lf-field">

                  <label>
                    Command Prefix
                  </label>

                  <input
                    type="text"
                    name="prefix"
                    class="lf-input"
                    placeholder="<%= guild.prefix %>"
                    autocomplete="off"
                  />

                </div>


                <div class="lf-checks">

                  <label class="lf-check">

                    <span class="lf-check-text">

                      <span class="lf-check-title">
                        Flag Translation
                      </span>

                      <span class="lf-check-description">
                        Automatically translate country flags.
                      </span>

                    </span>

                    <% if(guild.flag_translation?.enabled) { %>

                      <input
                        type="checkbox"
                        name="flag_translation"
                        checked
                      />

                    <% } else { %>

                      <input
                        type="checkbox"
                        name="flag_translation"
                      />

                    <% } %>

                    <span class="lf-switch"></span>

                  </label>


                  <label class="lf-check">

                    <span class="lf-check-text">

                      <span class="lf-check-title">
                        Invite Tracking
                      </span>

                      <span class="lf-check-description">
                        Track server invite usage.
                      </span>

                    </span>

                    <% if(guild.invite.tracking) { %>

                      <input
                        type="checkbox"
                        name="invite_tracking"
                        checked
                      />

                    <% } else { %>

                      <input
                        type="checkbox"
                        name="invite_tracking"
                      />

                    <% } %>

                    <span class="lf-switch"></span>

                  </label>

                </div>

              </div>

              <div class="lf-card-footer">

                <button
                  type="submit"
                  name="basicUpdate"
                  class="lf-save"
                >
                  Save Changes
                </button>

              </div>

            </form>

          </div>


          <!-- ===================================
               STATISTICS
          ==================================== -->

          <div class="lf-card">

            <div class="lf-card-head">

              <div class="lf-card-icon">
                <i class="fa fa-bar-chart"></i>
              </div>

              <div class="lf-card-title">
                <h2>Statistics</h2>
                <p>XP and level tracking configuration</p>
              </div>

            </div>

            <form
              role="form"
              action="/manage/<%= guild.id %>/basic/"
              method="POST"
            >

              <div class="lf-card-body">

                <div class="lf-field">

                  <label class="lf-check">

                    <span class="lf-check-text">

                      <span class="lf-check-title">
                        XP Tracking
                      </span>

                      <span class="lf-check-description">
                        Enable member ranking and XP tracking.
                      </span>

                    </span>

                    <% if(guild.stats.enabled) { %>

                      <input
                        type="checkbox"
                        name="ranking"
                        checked
                      />

                    <% } else { %>

                      <input
                        type="checkbox"
                        name="ranking"
                      />

                    <% } %>

                    <span class="lf-switch"></span>

                  </label>

                </div>


                <div class="lf-field">

                  <label>
                    Levelup Message
                  </label>

                  <input
                    type="text"
                    name="levelup_message"
                    class="lf-input"
                    placeholder="<%= guild.stats.xp.message %>"
                  />

                </div>


                <div class="lf-field">

                  <label>
                    Levelup Channel
                  </label>

                  <select
                    class="lf-select"
                    name="levelup_channel"
                  >

                    <% if(guild.stats.xp.channel && bot.channels.cache.has(guild.stats.xp.channel)){ %>

                      <option selected="selected">
                        #<%= bot.channels.cache.get(guild.stats.xp.channel).name %>
                      </option>

                      <% guild.channels.cache
                        .filter((ch) =>
                          ch.type === 0 &&
                          ch.id !== guild.stats.xp.channel
                        )
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                      <option>
                        No channel
                      </option>

                    <% } else { %>

                      <option
                        disabled
                        selected
                        value
                      >
                        -- select an option --
                      </option>

                      <% guild.channels.cache
                        .filter((ch) => ch.type === 0)
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                    <% } %>

                  </select>

                </div>

              </div>

              <div class="lf-card-footer">

                <button
                  type="submit"
                  name="statsUpdate"
                  class="lf-save"
                >
                  Save Changes
                </button>

              </div>

            </form>

          </div>

<!-- ===================================
               TICKET
          ==================================== -->

          <div class="lf-card">

            <div class="lf-card-head">

              <div class="lf-card-icon">
                <i class="fa fa-ticket"></i>
              </div>

              <div class="lf-card-title">
                <h2>Ticket</h2>
                <p>Configure support ticket behavior</p>
              </div>

            </div>

            <form
              role="form"
              action="/manage/<%= guild.id %>/basic/"
              method="POST"
            >

              <div class="lf-card-body">

                <div class="lf-field">

                  <label>
                    Ticket Limit
                  </label>

                  <input
                    type="number"
                    name="limit"
                    class="lf-input"
                    placeholder="<%= guild.ticket.limit %>"
                    min="0"
                  />

                </div>


                <div class="lf-field">

                  <label>
                    Ticket Logs
                  </label>

                  <select
                    class="lf-select"
                    name="channel"
                  >

                    <% if(guild.ticket.log_channel && bot.channels.cache.has(guild.ticket.log_channel)){ %>

                      <option selected="selected">
                        #<%= bot.channels.cache.get(guild.ticket.log_channel).name %>
                      </option>

                      <% guild.channels.cache
                        .filter((ch) =>
                          ch.type === 0 &&
                          ch.id !== guild.ticket.log_channel
                        )
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                      <option>
                        No channel
                      </option>

                    <% } else { %>

                      <option
                        disabled
                        selected
                        value
                      >
                        -- select an option --
                      </option>

                      <% guild.channels.cache
                        .filter((ch) => ch.type === 0)
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                    <% } %>

                  </select>

                </div>

              </div>

              <div class="lf-card-footer">

                <button
                  type="submit"
                  name="ticketUpdate"
                  class="lf-save"
                >
                  Save Changes
                </button>

              </div>

            </form>

          </div>


          <!-- ===================================
               MODERATION
          ==================================== -->

          <div class="lf-card">

            <div class="lf-card-head">

              <div class="lf-card-icon">
                <i class="fa fa-shield"></i>
              </div>

              <div class="lf-card-title">
                <h2>Moderation</h2>
                <p>Warnings and moderation logs</p>
              </div>

            </div>

            <form
              role="form"
              action="/manage/<%= guild.id %>/basic/"
              method="POST"
            >

              <div class="lf-card-body">

                <div class="lf-field">

                  <label>
                    Max Warnings
                  </label>

                  <input
                    type="number"
                    name="max_warnings"
                    class="lf-input"
                    placeholder="<%= guild.max_warn.limit %>"
                    min="0"
                  />

                </div>


                <div class="lf-field">

                  <label>
                    Max Warnings Action
                  </label>

                  <select
                    class="lf-select"
                    name="max_warn_action"
                  >

                    <option selected="selected">
                      <%= guild.max_warn.action %>
                    </option>

                    <% if(guild.max_warn.action !== "TIMEOUT") { %>
                      <option>TIMEOUT</option>
                    <% } %>

                    <% if(guild.max_warn.action !== "KICK") { %>
                      <option>KICK</option>
                    <% } %>

                    <% if(guild.max_warn.action !== "BAN") { %>
                      <option>BAN</option>
                    <% } %>

                  </select>

                </div>


                <div class="lf-field">

                  <label>
                    Moderation Logs
                  </label>

                  <select
                    class="lf-select"
                    name="modlog_channel"
                  >

                    <% if(guild.modlog_channel && bot.channels.cache.has(guild.modlog_channel)){ %>

                      <option selected="selected">
                        #<%= bot.channels.cache.get(guild.modlog_channel).name %>
                      </option>

                      <% guild.channels.cache
                        .filter((ch) =>
                          ch.type === 0 &&
                          ch.id !== guild.modlog_channel
                        )
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                      <option>
                        No channel
                      </option>

                    <% } else { %>

                      <option
                        disabled
                        selected
                        value
                      >
                        -- select an option --
                      </option>

                      <% guild.channels.cache
                        .filter((ch) => ch.type === 0)
                        .forEach((ch) => { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% }); %>

                    <% } %>

                  </select>

                </div>

              </div>

              <div class="lf-card-footer">

                <button
                  type="submit"
                  name="modUpdate"
                  class="lf-save"
                >
                  Save Changes
                </button>

              </div>

            </form>

          </div>

<!-- ===================================
               AUTOMOD
          ==================================== -->

          <div class="lf-card full">

            <div class="lf-card-head">

              <div class="lf-card-icon">
                <i class="fa fa-lock"></i>
              </div>

              <div class="lf-card-title">
                <h2>Auto Moderation</h2>
                <p>
                  Protect your server from spam, links and unwanted content
                </p>
              </div>

            </div>

            <form
              role="form"
              action="/manage/<%= guild.id %>/basic/"
              method="POST"
            >

              <div class="lf-card-body">

                <div class="lf-automod-grid">

                  <!-- AUTOMOD LIMITS -->

                  <div class="lf-automod-panel">

                    <div class="lf-panel-title">
                      Limits & Actions
                    </div>

                    <div class="lf-field">

                      <label>
                        Max Strikes
                      </label>

                      <input
                        type="number"
                        name="max_strikes"
                        class="lf-input"
                        placeholder="<%= guild.automod.strikes %>"
                        min="0"
                      />

                    </div>


                    <div class="lf-field">

                      <label>
                        Max Strikes Action
                      </label>

                      <select
                        class="lf-select"
                        name="automod_action"
                      >

                        <option selected="selected">
                          <%= guild.automod.action %>
                        </option>

                        <% if(guild.automod.action !== "TIMEOUT") { %>
                          <option>TIMEOUT</option>
                        <% } %>

                        <% if(guild.automod.action !== "KICK") { %>
                          <option>KICK</option>
                        <% } %>

                        <% if(guild.automod.action !== "BAN") { %>
                          <option>BAN</option>
                        <% } %>

                      </select>

                    </div>


                    <div class="lf-field">

                      <label>
                        Max Lines
                      </label>

                      <input
                        type="number"
                        name="max_lines"
                        class="lf-input"
                        placeholder="<%= guild.automod.max_lines %>"
                        min="0"
                      />

                    </div>

                  </div>


                  <!-- PROTECTION -->

                  <div class="lf-automod-panel">

                    <div class="lf-panel-title">
                      Protection Features
                    </div>

                    <div class="lf-automod-toggles">


                      <!-- ANTI ATTACHMENTS -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Attachments
                          </span>

                        </span>

                        <% if(guild.automod.anti_attachments) { %>

                          <input
                            type="checkbox"
                            name="anti_attachments"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_attachments"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>


                      <!-- ANTI INVITES -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Invites
                          </span>

                        </span>

                        <% if(guild.automod.anti_invites) { %>

                          <input
                            type="checkbox"
                            name="anti_invites"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_invites"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>


                      <!-- ANTI LINKS -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Links
                          </span>

                        </span>

                        <% if(guild.automod.anti_links) { %>

                          <input
                            type="checkbox"
                            name="anti_links"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_links"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>


                      <!-- ANTI SPAM -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Spam
                          </span>

                        </span>

                        <% if(guild.automod.anti_spam) { %>

                          <input
                            type="checkbox"
                            name="anti_spam"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_spam"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>


                      <!-- ANTI GHOSTPING -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Ghostping
                          </span>

                        </span>

                        <% if(guild.automod.anti_ghostping) { %>

                          <input
                            type="checkbox"
                            name="anti_ghostping"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_ghostping"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>


                      <!-- ANTI MASSMENTION -->

                      <label class="lf-check">

                        <span class="lf-check-text">

                          <span class="lf-check-title">
                            Anti Massmention
                          </span>

                        </span>

                        <% if(guild.automod.anti_massmention) { %>

                          <input
                            type="checkbox"
                            name="anti_massmention"
                            checked
                          />

                        <% } else { %>

                          <input
                            type="checkbox"
                            name="anti_massmention"
                          />

                        <% } %>

                        <span class="lf-switch"></span>

                      </label>

                    </div>

                  </div>

                </div>


                <!-- WHITELIST CHANNELS -->

                <div
                  class="lf-field"
                  style="margin-top:22px;"
                >

                  <label>
                    Whitelisted Channels
                  </label>

                  <select
                    class="lf-select"
                    name="channels"
                    multiple
                  >

                    <% guild.channels.cache
                      .filter((ch) => ch.type === 0)
                      .forEach((ch) => { %>

                      <% if(guild.automod.wh_channels.includes(ch.id)) { %>

                        <option selected="selected">
                          #<%= ch.name %>
                        </option>

                      <% } else { %>

                        <option>
                          #<%= ch.name %>
                        </option>

                      <% } %>

                    <% }); %>

                  </select>

                  <div class="lf-help">
                    Hold CTRL / CMD to select multiple channels.
                  </div>

                </div>

              </div>


              <div class="lf-card-footer">

                <button
                  type="submit"
                  name="automodUpdate"
                  class="lf-save"
                >
                  Save Changes
                </button>

              </div>

            </form>

          </div>

        </div>

      </div>

    </section>

  </div>

  <%- include('../includes/footer') %>

</div>

</body>
</html>
